pkgname=sway-config
pkgver=0.1.0
pkgrel=1
pkgdesc="GTK4/libadwaita GUI for configuring Sway and Waybar"
arch=('x86_64' 'aarch64')
url="https://github.com/danvincent/sway-config"
license=('MIT')
depends=('gtk4' 'libadwaita' 'sway' 'waybar')
makedepends=('cargo' 'pkgconf')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 target/release/sway-config "${pkgdir}/usr/bin/sway-config"
  install -Dm644 packaging/sway-config.desktop "${pkgdir}/usr/share/applications/sway-config.desktop"
  install -Dm644 packaging/sway-config.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/sway-config.svg"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/sway-config/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/doc/sway-config/LICENSE"
}
